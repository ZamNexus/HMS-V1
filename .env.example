# Backend origin that the Next.js `/api/*` (and `/health`) rewrite proxies to.
# Server-side only: do NOT prefix with NEXT_PUBLIC_. Copy to .env.local.
#
# Development backend:
BACKEND_URL=https://zamnexus-hms-api-dev-3aa783b02dad.herokuapp.com
# Local backend:
# BACKEND_URL=http://localhost:3000

# Data source for the Users / Roles / Doctors screens: "mock" (demo data) or "api" (real backend;
# requires docs/FRONTEND_BACKEND_INTEGRATION_HANDOFF.md to be completed first).
# Unset: development uses "mock", production builds use "api" (demo data never ships by omission).
# NEXT_PUBLIC_HMS_DATA_SOURCE=mock
